{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["steamcmd"],
  "properties": {
    "hby": {
      "type": "object",
      "required": ["ports"],
      "properties": { "ports": { "type": "array", "minItems": 1 } }
    },
    "steamcmd": {
      "type": "object",
      "required": ["appId", "startup"],
      "properties": {
        "appId": { "type": "string", "pattern": "^[0-9]+$" },
        "startup": { "type": "string", "minLength": 1 },
        "autoUpdate": { "type": "boolean" },
        "validate": { "type": "boolean" },
        "betaId": { "type": "string" },
        "betaPassword": { "type": "string" },
        "installFlags": { "type": "string" },
        "bootstrap": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "policy": { "enum": ["IfChanged", "Always"] },
            "script": { "type": "string" }
          },
          "allOf": [{ "if": { "properties": { "enabled": { "const": true } } }, "then": { "required": ["script"], "properties": { "script": { "minLength": 1 } } } }]
        }
      }
    }
  }
}
