{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "replicaCount": { "const": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "containerPort", "servicePort", "protocol"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$", "maxLength": 15 },
          "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "servicePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "protocol": { "enum": ["TCP", "UDP"] }
        }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "address": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "pattern": "^/" },
        "secureCookies": { "type": "boolean" }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mountPath": { "type": "string", "pattern": "^/" },
        "size": { "type": "string", "minLength": 1 }
      }
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "items": { "type": "array", "items": { "type": "object", "required": ["spec"] } }
      }
    },
    "gatewayRoutes": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "port", "parentRefs"],
            "properties": {
              "kind": { "enum": ["HTTPRoute", "TCPRoute", "UDPRoute"] },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "parentRefs": { "type": "array", "minItems": 1 }
            }
          }
        }
      }
    }
  }
}
