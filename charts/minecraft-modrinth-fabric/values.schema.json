{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["minecraft", "modrinth"],
  "properties": {
    "hby": {
      "type": "object",
      "required": ["ports"],
      "properties": { "ports": { "type": "array", "minItems": 1 } }
    },
    "minecraft": {
      "type": "object",
      "required": ["eula", "serverJarFile", "startup"],
      "properties": {
        "eula": { "type": "boolean" },
        "serverJarFile": { "type": "string", "minLength": 1 },
        "startup": { "type": "string", "minLength": 1 },
        "extraJars": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "sha512", "targetPath"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "sha512": { "type": "string", "pattern": "^[A-Fa-f0-9]{128}$" },
              "targetPath": { "type": "string", "pattern": "^[^/].*\\.jar$" }
            }
          }
        }
      }
    },
    "modrinth": {
      "type": "object",
      "properties": {
        "installPolicy": { "enum": ["IfChanged", "Always"] },
        "pack": {
          "type": "object",
          "properties": { "sha512": { "type": "string", "pattern": "^$|^[A-Fa-f0-9]{128}$" } }
        }
      },
      "anyOf": [
        { "required": ["projectId"], "properties": { "projectId": { "minLength": 1 } } },
        { "required": ["pack"], "properties": { "pack": { "required": ["url", "sha512"], "properties": { "url": { "minLength": 1 }, "sha512": { "minLength": 128 } } } } }
      ]
    }
  }
}
