{
  "$schema": "https://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "minecraft": {
      "type": "object",
      "properties": {
        "eula": {
          "type": "boolean"
        },
        "serverJarFile": {
          "type": "string",
          "minLength": 1
        },
        "startup": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commandArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "javaOpts": {
          "type": "string"
        },
        "args": {
          "type": "string"
        },
        "dataDir": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "extraJars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/minecraftExtraJar"
          }
        },
        "extraPorts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/containerPort"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "modrinth": {
      "type": "object",
      "properties": {
        "apiBase": {
          "type": "string",
          "format": "uri"
        },
        "projectId": {
          "type": "string"
        },
        "versionId": {
          "type": "string"
        },
        "versionNumber": {
          "type": "string"
        },
        "userAgent": {
          "type": "string",
          "minLength": 1
        },
        "installPolicy": {
          "type": "string",
          "enum": [
            "IfChanged",
            "Always"
          ]
        },
        "fabricInstallerVersion": {
          "type": "string",
          "minLength": 1
        },
        "auth": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "scheme": {
              "type": "string",
              "enum": [
                "raw",
                "bearer",
                "Bearer"
              ]
            },
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string",
              "minLength": 1
            },
            "createSecret": {
              "type": "boolean"
            },
            "token": {
              "type": "string"
            }
          }
        },
        "pack": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "filename": {
              "type": "string",
              "minLength": 1
            },
            "sha512": {
              "type": "string",
              "pattern": "^$|^[A-Fa-f0-9]{128}$"
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "extraPorts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/servicePort"
          }
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClassName": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "probes": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalSecret"
          }
        },
        "metadata": {
          "type": "object"
        },
        "spec": {
          "type": "object"
        }
      }
    },
    "gatewayIngress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gatewayRoute"
          }
        }
      }
    }
  },
  "$defs": {
    "externalSecret": {
      "type": "object",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "labels": {
              "type": "object"
            }
          }
        },
        "spec": {
          "type": "object"
        }
      }
    },
    "minecraftExtraJar": {
      "type": "object",
      "required": [
        "url",
        "sha512",
        "targetPath"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "sha512": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{128}$"
        },
        "targetPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/].*\\.jar$"
        }
      }
    },
    "gatewayRoute": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "",
            "TCPRoute",
            "HTTPRoute"
          ]
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalDNS": {
          "type": "boolean"
        },
        "port": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "string"
            }
          ]
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        },
        "spec": {
          "type": "object",
          "properties": {
            "parentRefs": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "containerPort": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "containerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "protocol": {
          "type": "string"
        }
      }
    },
    "servicePort": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "string"
            }
          ]
        },
        "protocol": {
          "type": "string"
        },
        "appProtocol": {
          "type": "string"
        }
      }
    }
  }
}
